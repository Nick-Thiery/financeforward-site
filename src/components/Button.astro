---
/*
 * Pill-shaped link button. `external` adds the ↗ arrow and rel="noopener";
 * external links still open in the same tab.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'ink' | 'outline' | 'remlo' | 'remlo-outline';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  /** Leading icon, e.g. for the mailto buttons. */
  icon?: IconName;
  /** Stretch to the container width below 640px. */
  fullOnMobile?: boolean;
}

const {
  href,
  variant = 'ink',
  size = 'lg',
  external = false,
  icon,
  fullOnMobile = false,
} = Astro.props;
const arrowSize = size === 'sm' ? 15 : 17;
const leavesSite = external || /^https?:\/\//.test(href);
---

<a
  class:list={['button', `button--${variant}`, `button--${size}`, { 'button--full': fullOnMobile }]}
  href={href}
  rel={leavesSite ? 'noopener' : undefined}
>
  {icon && <Icon name={icon} size={18} strokeWidth={2} />}
  <span>
    <slot />
  </span>
  {external && (
    <span class="button__arrow">
      <Icon name="arrow-ne" size={arrowSize} strokeWidth={2.2} />
    </span>
  )}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1.5px solid transparent;
    border-radius: var(--ff-radius-pill);
    font-family: var(--ff-font-sans);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.1s ease;
  }

  .button--sm {
    min-height: 44px;
    padding: 0 20px;
    font-size: 16px;
  }

  .button--md {
    min-height: 52px;
    padding: 0 22px;
    font-size: 17px;
  }

  .button--lg {
    min-height: 56px;
    padding: 0 26px;
    font-size: 18px;
  }

  .button--ink {
    background: var(--ff-ink);
    color: var(--ff-white);
  }

  .button--ink:hover {
    background: var(--ff-ink-hover);
  }

  .button--ink:active {
    background: #000;
  }

  .button--outline {
    background: var(--ff-white);
    border-color: var(--ff-field);
    color: var(--ff-ink);
  }

  .button--outline:hover {
    background: var(--ff-paper);
    border-color: var(--ff-ink);
  }

  .button--outline:active {
    background: var(--ff-pressed);
    border-color: var(--ff-ink);
  }

  .button--remlo {
    background: var(--remlo-ink);
    color: var(--ff-white);
  }

  .button--remlo:hover {
    background: var(--remlo-ink-hover);
  }

  .button--remlo:active {
    background: var(--remlo-label);
  }

  .button--remlo-outline {
    background: var(--remlo-tint);
    border-color: var(--remlo-field);
    color: var(--ff-ink);
  }

  .button--remlo-outline:hover,
  .button--remlo-outline:active {
    background: var(--ff-white);
    border-color: var(--remlo-ink);
  }

  .button:active {
    transform: scale(0.98);
  }

  .button__arrow {
    display: inline-flex;
    transition: transform 0.15s ease;
  }

  .button:hover .button__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 639.98px) {
    .button--full {
      display: flex;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .button__arrow {
      transition: none;
    }

    .button:active,
    .button:hover .button__arrow {
      transform: none;
    }
  }
</style>
