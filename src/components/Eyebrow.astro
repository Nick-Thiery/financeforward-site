---
/*
 * Small caps label above a section heading, with a 28×2 accent rule.
 * The Remlo variant shows the Remlo icon instead of the rule.
 */
import { Picture } from 'astro:assets';
import { approvedImage } from '../content/images';

interface Props {
  tone?: 'accent' | 'on-dark' | 'remlo';
}

const { tone = 'accent' } = Astro.props;
const remloIcon = tone === 'remlo' ? approvedImage('remlo-icon-small') : undefined;
---

<p class:list={['eyebrow', `eyebrow--${tone}`]}>
  {tone === 'remlo' ? (
    remloIcon && (
      <Picture
        class="eyebrow__icon"
        src={remloIcon.src}
        alt={remloIcon.alt}
        width={48}
        height={48}
        densities={[1, 2]}
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
      />
    )
  ) : (
    <span class="eyebrow__rule" aria-hidden="true" />
  )}
  <span>
    <slot />
  </span>
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ff-accent-ink);
  }

  .eyebrow__rule {
    display: block;
    flex-shrink: 0;
    width: 22px;
    height: 2px;
    background: var(--ff-accent-line);
  }

  .eyebrow--on-dark {
    color: var(--ff-accent-on-dark);
  }

  .eyebrow--on-dark .eyebrow__rule {
    background: var(--ff-accent-on-dark);
  }

  .eyebrow--remlo {
    gap: 12px;
    color: var(--remlo-ink);
  }

  .eyebrow--remlo :global(.eyebrow__icon img),
  .eyebrow--remlo :global(img.eyebrow__icon) {
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  @media (min-width: 1024px) {
    .eyebrow {
      gap: 12px;
      font-size: 13px;
    }

    .eyebrow__rule {
      width: 28px;
    }

    .eyebrow--remlo {
      gap: 14px;
    }

    .eyebrow--remlo :global(.eyebrow__icon img),
    .eyebrow--remlo :global(img.eyebrow__icon) {
      width: 48px;
      height: 48px;
      border-radius: 12px;
    }
  }
</style>
