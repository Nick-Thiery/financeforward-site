---
/*
 * A Remlo feature: a visual (EstimateQuote or PhoneFrame, via the default
 * slot), a title and a short description. Rendered as a list item.
 */
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<li class="feature" data-feature>
  <div class="feature__visual">
    <slot />
  </div>
  <h3 class="feature__title">{title}</h3>
  <p class="feature__body">{body}</p>
</li>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 22px 24px;
    border: 1px solid var(--remlo-line);
    border-radius: var(--ff-radius-card);
    background: var(--ff-white);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .feature__visual {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .feature__visual:empty {
    display: none;
  }

  .feature__visual :global(.phone) {
    align-self: center;
  }

  .feature__title {
    font-size: 22px;
    line-height: 1.2;
  }

  .feature__body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ff-ink-2);
  }

  @media (min-width: 1024px) {
    .feature {
      gap: 14px;
      padding: 28px 30px 32px;
    }

    .feature:hover {
      box-shadow: 0 14px 34px rgb(22 24 29 / 0.1);
      transform: translateY(-2px);
    }

    .feature__title {
      font-size: 25px;
    }

    .feature__body {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature {
      transition: none;
    }

    .feature:hover {
      transform: none;
    }
  }
</style>
