---
/*
 * Line icons used across the site (24×24 grid, stroked, always decorative).
 * Paths are taken from the design exports.
 */
export type IconName =
  | 'transfer'
  | 'calendar'
  | 'card'
  | 'dollar'
  | 'shield-alert'
  | 'shield-check'
  | 'search'
  | 'check'
  | 'minus-circle'
  | 'arrow-ne'
  | 'mail'
  | 'message'
  | 'alert'
  | 'menu'
  | 'close';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  /** `current` inherits the text colour. */
  tone?: 'current' | 'accent' | 'remlo' | 'ink';
}

const { name, size = 24, strokeWidth = 1.8, tone = 'current' } = Astro.props;

const paths: Record<IconName, string> = {
  transfer:
    '<path d="M4 8h13"/><path d="m13 4 4 4-4 4"/><path d="M20 16H7"/><path d="m11 20-4-4 4-4"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  card: '<rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 10h18"/>',
  dollar:
    '<path d="M12 3v18"/><path d="M17 7.5c0-1.9-2.2-3-5-3s-5 1.1-5 3 2.2 2.7 5 3.3 5 1.4 5 3.4-2.2 3.3-5 3.3-5-1.3-5-3.3"/>',
  'shield-alert':
    '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="M12 8v5"/><path d="M12 16.5h.01"/>',
  'shield-check':
    '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8 11h6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  'minus-circle': '<circle cx="12" cy="12" r="9"/><path d="M8 12h8"/>',
  'arrow-ne': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  message: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l.9-5.4A8 8 0 1 1 21 12Z"/>',
  alert:
    '<path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
};
---

<svg
  class:list={['icon', `tone-${tone}`]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex-shrink: 0;
  }

  .tone-accent {
    color: var(--ff-accent-line);
  }

  .tone-remlo {
    color: var(--remlo-ink);
  }

  .tone-ink {
    color: var(--ff-ink);
  }
</style>
