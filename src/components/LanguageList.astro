---
/*
 * Remlo's languages, from languages.ts. `panel` is the hero figure (two
 * columns and a caption); `chips` is the row in the Remlo section.
 */
import { languages } from '../content/languages';

interface Props {
  variant: 'panel' | 'chips';
  id: string;
  label: string;
  caption?: string;
}

const { variant, id, label, caption } = Astro.props;
const labelId = `${id}-label`;
---

{variant === 'panel' ? (
  <figure class="language-panel">
    <div class="language-panel__body">
      <p class="language-panel__label" id={labelId}>
        {label}
      </p>
      <ul class="language-panel__list" aria-labelledby={labelId}>
        {languages.map((language) => (
          <li lang={language.code} dir={language.dir}>
            {language.label}
          </li>
        ))}
      </ul>
    </div>
    {caption && <figcaption class="language-panel__caption">{caption}</figcaption>}
  </figure>
) : (
  <div class="language-chips">
    <p class="language-chips__label" id={labelId}>
      {label}
    </p>
    <ul class="language-chips__list" aria-labelledby={labelId}>
      {languages.map((language) => (
        <li lang={language.code} dir={language.dir}>
          {language.label}
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /* Hero panel: sized by its container (see the hero visual in index.astro). */
  .language-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    height: 100%;
    padding: 8.5cqi 6.9cqi 6.2cqi 26.5cqi;
    border-radius: 28px;
    background: var(--ff-paper);
    overflow: hidden;
  }

  .language-panel__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .language-panel__label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ff-accent-ink);
  }

  .language-panel__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 14px;
    font-family: var(--ff-font-scripts);
    font-size: clamp(16px, 3.65cqi, 19px);
    line-height: 1.35;
    color: var(--ff-ink);
  }

  .language-panel__list [dir='rtl'] {
    text-align: left;
  }

  .language-panel__caption {
    font-size: 13px;
    line-height: 1.45;
    color: var(--ff-muted);
  }

  /* Remlo section chips */
  .language-chips {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .language-chips__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--remlo-label);
  }

  .language-chips__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--ff-font-scripts);
    font-size: 15px;
    line-height: 1.5;
  }

  .language-chips__list li {
    padding: 7px 12px;
    border: 1px solid var(--remlo-chip-line);
    border-radius: var(--ff-radius-pill);
    background: var(--ff-white);
  }

  @media (min-width: 1024px) {
    .language-chips__label {
      font-size: 13px;
    }

    .language-chips__list li {
      padding-inline: 13px;
    }
  }
</style>
