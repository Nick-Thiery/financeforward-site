---
/*
 * A Remlo screenshot in a simple dark phone frame. Renders nothing unless the
 * image is approved in images.ts, so there is never an empty frame.
 */
import { Picture } from 'astro:assets';
import { approvedImage, type ImageId } from '../content/images';

interface Props {
  image: ImageId;
  size: 'hero' | 'feature';
  /** The hero phone is the page's key image: eager, high priority. */
  priority?: boolean;
}

const { image, size, priority = false } = Astro.props;
const entry = approvedImage(image);

// Rendered width of the screen inside the frame, per layout.
const sizes =
  size === 'hero'
    ? '(min-width: 1024px) min(220px, 15.6vw), (min-width: 640px) 220px, 204px'
    : '(min-width: 1024px) 174px, 154px';
---

{entry && (
  <div class:list={['phone', `phone--${size}`]}>
    <Picture
      class="phone__screen"
      src={entry.src}
      alt={entry.alt}
      widths={[240, 360, 480, 640, 780]}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
)}

<style>
  .phone {
    background: var(--ff-ink);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .phone :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Hero: sized by the hero visual; 8px bezel. */
  .phone--hero {
    width: 100%;
    height: 100%;
    padding: 8px;
    border-radius: 36px;
    box-shadow:
      0 24px 48px rgb(22 24 29 / 0.2),
      0 2px 8px rgb(22 24 29 / 0.12);
  }

  .phone--hero :global(img) {
    border-radius: 28px;
  }

  /* Feature cards: 168×356 on mobile, 190×408 on desktop. */
  .phone--feature {
    width: 168px;
    height: 356px;
    border: 7px solid var(--ff-ink);
    border-radius: 28px;
    overflow: hidden;
  }

  .phone--feature :global(img) {
    border-radius: 21px;
  }

  @media (min-width: 1024px) {
    .phone--hero {
      border-radius: 38px;
    }

    .phone--hero :global(img) {
      border-radius: 30px;
    }

    .phone--feature {
      width: 190px;
      height: 408px;
      border-width: 8px;
      border-radius: 32px;
      box-shadow: 0 18px 36px rgb(22 24 29 / 0.16);
    }

    .phone--feature :global(img) {
      border-radius: 24px;
    }
  }
</style>
