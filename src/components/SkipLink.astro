---
import { site } from '../content/site';

interface Props {
  /** The link text, in the page's language. Defaults to the English label. */
  label?: string;
}

const { label = site.header.skipLink } = Astro.props;
---

<a class="skip-link" href="#main">
  {label}
</a>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: var(--ff-radius-pill);
    background: var(--ff-ink);
    color: var(--ff-white);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
