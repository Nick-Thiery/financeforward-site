---
/*
 * Document shell: meta, fonts, global styles and the site script.
 *
 * Indexing: a page is noindex unless PUBLIC_SITE_INDEXABLE is exactly "true"
 * at build time. It is set in the Vercel project's Production environment
 * only, so production builds are indexable and preview builds are not. The
 * 404 page is always noindex.
 *
 * Canonical and og:url use the `site` in astro.config.mjs.
 */
import newsreader500 from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
import atkinson400 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !noindex;
// Real pages get a canonical URL on the permanent domain; the 404 page doesn't.
const canonical = noindex || !Astro.site ? undefined : new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.brand.name} />
        <meta property="og:locale" content="en_SG" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    {/* The gold chart mark, cropped from the logo (8 Oct 2026). */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={newsreader500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinson400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
