---
/*
 * Document shell: meta, fonts, global styles and the site script.
 *
 * Indexing: a page is noindex unless PUBLIC_SITE_INDEXABLE is exactly "true"
 * at build time. It is set in the Vercel project's Production environment
 * only, so production builds are indexable and preview builds are not. The
 * 404 page is always noindex.
 *
 * Canonical and og:url use the `site` in astro.config.mjs.
 *
 * Guide pages (see components/GuidePage.astro) also set the document language,
 * hreflang alternates and JSON-LD. A `draft` page (a translation that a native
 * speaker has not checked yet) is noindex in every build, with no canonical.
 */
import newsreader500 from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
import atkinson400 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Value of <html lang>. */
  lang?: string;
  dir?: 'ltr' | 'rtl';
  /** og:locale, for example en_SG. */
  ogLocale?: string;
  /** An unchecked translation: noindex, no canonical, no hreflang. */
  draft?: boolean;
  /** <link rel="alternate" hreflang>, absolute URLs. */
  alternates?: { hreflang: string; href: string }[];
  /** Structured data, written as a JSON-LD data block. */
  jsonLd?: object;
  /** Preload the Latin web fonts. Off for pages in other scripts, which use system fonts. */
  latinFonts?: boolean;
}

const {
  title,
  description,
  noindex = false,
  lang = 'en-SG',
  dir = 'ltr',
  ogLocale = 'en_SG',
  draft = false,
  alternates = [],
  jsonLd,
  latinFonts = true,
} = Astro.props;
const unlisted = noindex || draft;
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !unlisted;
// A draft says plain "noindex" in the indexable build; the site-wide
// "noindex, nofollow" still applies to previews and to the 404 page.
const robots =
  noindex || import.meta.env.PUBLIC_SITE_INDEXABLE !== 'true' ? 'noindex, nofollow' : 'noindex';
// Real pages get a canonical URL on the permanent domain; the 404 page and drafts don't.
const canonical =
  unlisted || !Astro.site ? undefined : new URL(Astro.url.pathname, Astro.site).href;
// `<` is escaped so that no page text can close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content={robots} />}
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.brand.name} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {alternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
        ))}
      </>
    )}
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    {/* The gold chart mark, cropped from the logo (8 Oct 2026). */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {latinFonts && (
      <link rel="preload" href={newsreader500} as="font" type="font/woff2" crossorigin />
    )}
    {latinFonts && (
      <link rel="preload" href={atkinson400} as="font" type="font/woff2" crossorigin />
    )}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
