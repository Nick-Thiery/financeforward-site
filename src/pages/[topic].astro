---
/* English guide pages at the site root: /loan-sharks/ and /sending-money-home/. */
import GuidePage from '../components/GuidePage.astro';
import { guidePages } from '../content/guides';

export function getStaticPaths() {
  return guidePages
    .filter((page) => page.lang === 'en')
    .map((page) => ({ params: { topic: page.topic }, props: { page } }));
}

const { page } = Astro.props;
---

<GuidePage page={page} />
